<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The release is signed with the hardened runtime, the app and every externalBin with
     this file. Dictation (ondra-dictate, started by the app, which macOS asks on behalf of)
     needs the microphone, which the hardened runtime blocks without this. -->
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
