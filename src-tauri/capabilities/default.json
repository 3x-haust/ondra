{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window, the quick-capture panel and the pet",
  "windows": [
    "main",
    "capture",
    "pet-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-set-webview-zoom"
  ]
}
