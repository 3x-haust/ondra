{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ondra",
  "version": "0.38.36",
  "identifier": "dev.3xhaust.ondra",
  "build": {
    "beforeDevCommand": "pnpm bundle && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm bundle --release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Ondra",
        "width": 1360,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "trafficLightPosition": { "x": 18, "y": 31 },
        "backgroundColor": "#141414"
      },
      {
        "label": "capture",
        "title": "빠른 입력",
        "url": "index.html#capture",
        "width": 640,
        "height": 120,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost https://github.com https://*.githubusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; frame-src 'self' asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; connect-src 'self' https://api.github.com https://us.i.posthog.com ipc: asset: http://asset.localhost http://ipc.localhost ws://localhost:* ws://127.0.0.1:*",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/**", "$HOME/**"],
          "deny": ["$HOME/.ssh/**", "$HOME/.gnupg/**", "$HOME/.aws/**", "$HOME/.tauri/**", "$HOME/.config/gh/**", "$HOME/Library/Keychains/**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "externalBin": [
      "binaries/agent-browser",
      "binaries/agent-desktop",
      "binaries/agent-desktop-macos-helper",
      "binaries/ondra-binary",
      "binaries/ondra-simhelper",
      "binaries/ondra-cuhost"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "binaries/ondra-bgguard.dylib": "ondra-bgguard.dylib",
      "dmg/background.tiff": "dmg-background.tiff",
      "resources/agent-browser-skills/": "agent-browser-skills/",
      "resources/components.json": "components.json",
      "../skills/": "app-skills/",
      "../extensions/": "app-extensions/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCM0U2RkQzOUZGOUZCQzgKUldUSSsvbWYwMjgrYS9RSGNBQW5KS2hvbit3aW16WVN4akN2RkxrVTNKaExZTUJsTHQ0Y3lyd28K",
      "endpoints": ["https://github.com/3x-haust/ondra/releases/latest/download/latest.json"]
    }
  }
}
