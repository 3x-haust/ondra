{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ondra",
  "version": "0.1.0",
  "identifier": "dev.3xhaust.ondra",
  "build": {
    "beforeDevCommand": "pnpm bundle && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm bundle && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Ondra",
        "width": 1360,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "trafficLightPosition": { "x": 16, "y": 18 },
        "backgroundColor": "#141414"
      },
      {
        "label": "capture",
        "title": "빠른 입력",
        "url": "index.html#capture",
        "width": 640,
        "height": 120,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* ws://127.0.0.1:*",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "externalBin": [
      "binaries/agent-browser",
      "binaries/agent-desktop",
      "binaries/agent-desktop-macos-helper",
      "binaries/ondra-engine",
      "binaries/ondra-simhelper"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "dmg/background.tiff": "dmg-background.tiff",
      "resources/agent-browser-skills/": "agent-browser-skills/",
      "resources/engine/": "engine/",
      "resources/chrome/": "chrome/",
      "../skills/": "app-skills/",
      "../extensions/": "app-extensions/"
    }
  }
}
