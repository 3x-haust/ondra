@@ -0,0 +1,26 @@
+import Foundation
+import Testing
+import Virtualization
+@testable import lume
+
+@MainActor
+@Test("Disabled directory sharing creates no VirtioFS configuration", arguments: [false, true])
+func isolatedDirectoryConfiguration(explicitShare: Bool) throws {
+    var context = VMVirtualizationServiceContext(
+        cpuCount: 2, memorySize: 4 * 1024 * 1024 * 1024, display: "1024x768",
+        sharedDirectories: explicitShare
+            ? [SharedDirectory(hostPath: "/var/empty", tag: "test", readOnly: true)] : [],
+        mount: nil, hardwareModel: nil, machineIdentifier: nil, macAddress: "02:11:22:33:44:55",
+        diskPath: Path("/unused/disk"), nvramPath: Path("/unused/nvram"), recoveryMode: false,
+        usbMassStoragePaths: nil, additionalDiskPaths: nil, networkMode: .nat)
+    let actual = VZVirtualMachineConfiguration()
+    context.directorySharingEnabled = false
+    DarwinVirtualizationService.configureDirectorySharing(actual, config: context)
+    #expect(actual.directorySharingDevices.isEmpty)
+    context.directorySharingEnabled = true
+    DarwinVirtualizationService.configureDirectorySharing(actual, config: context)
+    #expect(!actual.directorySharingDevices.isEmpty)
+    context.directorySharingEnabled = false
+    DarwinVirtualizationService.configureDirectorySharing(actual, config: context)
+    #expect(actual.directorySharingDevices.isEmpty)
+}
