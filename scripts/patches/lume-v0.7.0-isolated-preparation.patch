+@MainActor
+@Test("VNC-disabled preparation never exposes host sharing callbacks")
+func isolatedPreparationContext() async throws {
+  let (root, _, context) = try makeDisplayTestDirectory()
+  defer { try? FileManager.default.removeItem(at: root) }
+  let service = MockVMVirtualizationService()
+  let vnc = MockVNCService(vmDirectory: context.dir)
+  let presenter = MockDisplayPresenter()
+  let vm = MockVM(
+    vmDirContext: context,
+    virtualizationServiceFactory: { supplied in
+      #expect(!supplied.directorySharingEnabled)
+      return service
+    },
+    vncServiceFactory: { _ in vnc },
+    displayPresenterFactory: { _, _ in presenter }
+  )
+  let runTask = Task {
+    try await vm.run(displayMode: .native, sharedDirectories: [], mount: nil, vncPolicy: .disabled)
+  }
+  try await waitUntil { presenter.showCount == 1 }
+  service.simulateGuestStop()
+  try await runTask.value
+  #expect(presenter.lastContext != nil)
+  #expect(presenter.lastContext?.copyFromGuest == nil)
+  #expect(presenter.lastContext?.pasteIntoGuest == nil)
+  #expect(presenter.lastContext?.addSharedFolder == nil)
+  #expect(presenter.lastContext?.copyFilesToGuestDesktop == nil)
+  #expect(vnc.startCallCount == 0)
+}
