# Local settings for Ondra. Copy to `.env` (dev build, repo root) or to
# `~/Library/Application Support/dev.3xhaust.ondra/.env` (installed app).

# Devices no job may boot or drive, as a regular expression on the device name
# (e.g. a team's shared simulators). Empty = none.
ONDRA_PROTECTED_DEVICES=

# Devices a job may use besides the ones it makes itself (comma-separated names/ids).
ONDRA_DEVICES_ALLOWED=

# Usage numbers and feedback (docs/TELEMETRY.md), read at build time. Empty = the build sends
# nothing. Release builds need both.
VITE_POSTHOG_KEY=
VITE_POSTHOG_SURVEY=
